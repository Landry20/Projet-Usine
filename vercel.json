{
  "version": 2,
  "buildCommand": "cd backend && npm install --include=dev && npm run build && cd ../frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip-root-install",
  "framework": null,
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "backend/{dist,node_modules,package.json}/**"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
