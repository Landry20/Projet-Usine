{
  "version": 2,
  "buildCommand": "cd backend && npm install --include=dev && npm run build && cd ../frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip-root-install",
  "framework": null,
  "functions": {
    "backend/handler.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{backend/dist/**,backend/node_modules/**,backend/package.json}"
    }
  },
  "rewrites": [
    { "source": "/v1", "destination": "/backend/handler?p=/v1" },
    { "source": "/v1/:path*", "destination": "/backend/handler?p=/v1/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
