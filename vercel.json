{
  "version": 2,
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip-root-install",
  "framework": null,
  "rewrites": [
    { "source": "/v1", "destination": "https://projet-usineapi.vercel.app/v1" },
    { "source": "/v1/:path*", "destination": "https://projet-usineapi.vercel.app/v1/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
